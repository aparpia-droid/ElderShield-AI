# Copy to .env and fill in values. These are the variables server.js reads.
# Do not commit real values.

# Server
PORT=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Public URLs so Twilio can reach the server
BASE_URL=
WSS_URL=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# ElevenLabs agent ids, one per scenario
AGENT_SOCIAL_SECURITY=
AGENT_APPLE_SUPPORT=
AGENT_LOTTERY=
AGENT_FINANCIAL_AID=
AGENT_CAMPUS_IT=
AGENT_INTERNSHIP=
ELEVEN_AGENT_ID_DEFAULT=

# Groq
GROQ_API_KEY=

# Study data
DATA_DIR=
EXPORT_TOKEN=

# Optional: caller-audio chunk size in ms (defaults to 20)
AUDIO_CHUNK_MS=
